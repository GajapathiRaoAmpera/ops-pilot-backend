# Server-side only. Copy to .env (git-ignored). Never commit or paste real values.
# Supabase: Project Settings -> Database -> Connection string. Use the Session pooler (port 5432)
# or Transaction pooler (port 6543). Prefix must be postgresql+psycopg:// and keep sslmode=require.
# OPSPILOT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5433/opspilot
OPSPILOT_GITHUB_TOKEN=
OPSPILOT_GITHUB_WEBHOOK_SECRET=
OPSPILOT_COOKIE_SECURE=false
# Sign-in throttle (defaults: 5 failures per 900s per email+IP)
# OPSPILOT_LOGIN_MAX_FAILURES=5
# OPSPILOT_LOGIN_WINDOW_SECONDS=900

# Production: set OPSPILOT_ENVIRONMENT=production. The API then refuses to start with a localhost database,
# no OPSPILOT_SECRET_KEY, insecure cookies, or localhost origins.
# OPSPILOT_ENVIRONMENT=production
# OPSPILOT_ALLOWED_ORIGINS=["https://app.example.com"]
# OPSPILOT_INVITE_TTL_HOURS=168
# OPSPILOT_RESET_TTL_MINUTES=120
# AI investigations (Groq). Put the real key only in .env, never in code or chat.
OPSPILOT_GROQ_API_KEY=
# OPSPILOT_GROQ_MODEL=openai/gpt-oss-120b
